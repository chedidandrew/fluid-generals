+
+Bool LookAtTranslator::verifyCameraSpeed()
+{
+    if (m_isScrolling) return FALSE;
+    const Coord2D position = TheTacticalView->getPosition2D();
+    const ICoord2D current = m_currentPos;
+    const Real height = TheTacticalView->getHeightAboveGround();
+    TheTacticalView->setHeightAboveGround(450.0f);
+    const auto wheel = [this](Real spin) {
+        GameMessage *msg = newInstance(GameMessage)(GameMessage::MSG_RAW_MOUSE_WHEEL);
+        msg->appendPixelArgument(m_currentPos);
+        msg->appendRealArgument(spin);
+        translateGameMessage(msg);
+        deleteInstance(msg);
+    };
+    wheel(-1.0f);
+    const Real out = TheTacticalView->getHeightAboveGround() - 450.0f;
+    wheel(1.0f);
+    const Real in = 450.0f + out - TheTacticalView->getHeightAboveGround();
+    TheTacticalView->setHeightAboveGround(height);
+    Bool previousDirs[4];
+    for (Int i = 0; i < 4; ++i) { previousDirs[i] = scrollDir[i]; scrollDir[i] = FALSE; }
+    scrollDir[DIR_RIGHT] = TRUE;
+    GameMessage *tick = newInstance(GameMessage)(GameMessage::MSG_FRAME_TICK);
+    setScrolling(SCROLL_KEY);
+    translateGameMessage(tick);
+    const Coord2D keyboard = TheInGameUI->getScrollAmount();
+    stopScrolling();
+    m_currentPos = ICoord2D{static_cast<Int>(TheDisplay->getWidth()) - 1, static_cast<Int>(TheDisplay->getHeight()) / 2};
+    setScrolling(SCROLL_SCREENEDGE);
+    translateGameMessage(tick);
+    const Coord2D edge = TheInGameUI->getScrollAmount();
+    stopScrolling();
+    deleteInstance(tick);
+    m_currentPos = current;
+    for (Int i = 0; i < 4; ++i) scrollDir[i] = previousDirs[i];
+    TheTacticalView->setPosition2D(position);
+    const Coord2D zero{0.0f, 0.0f};
+    TheTacticalView->scrollBy(&zero);
+    TheInGameUI->setScrollAmount(zero);
+    const Real ratio = fabs(keyboard.x) > 0.0001f ? edge.x / keyboard.x : 0.0f;
+    const Bool passed = fabs(out - 30.0f) < 0.01f && fabs(in - 30.0f) < 0.01f && fabs(ratio - 3.0f) < 0.01f;
+    printf("CNC240_CAMERA_SPEED passed=%d wheel_out=%.2f wheel_in=%.2f edge_to_keyboard_ratio=%.2f\n", passed, out, in, ratio);
+    fflush(stdout);
+    return passed;
+}
+
+bool cnc240::verifyCameraSpeed()
+{
+    return TheLookAtTranslator && TheLookAtTranslator->verifyCameraSpeed();
+}
