@@ -52,12 +52,50 @@
 #include "W3DDevice/GameClient/W3DShadow.h"
 
 #include "Common/file.h"
+#include "WW3D2/camera.h"
+#include <algorithm>
+#include <cmath>
 
 
 #define K_OBSOLETE_HEIGHT_MAP_VERSION 8
 
 #define PATHFIND_CLIFF_SLOPE_LIMIT_F	9.8f
 
+// Ground footprint in map vertex coordinates, including every legal terrain height.
+// Bounds are clipped to the real map; a sky-facing corner needs the whole map.
+IRegion2D WorldHeightMap::getCameraDrawBounds(const CameraClass &camera) const
+{
+    Vector2 lo, hi;
+    camera.Get_View_Plane(lo, hi);
+    const Matrix3D &matrix = camera.Get_Transform();
+    const Vector3 origin = camera.Get_Position();
+    Real minX = static_cast<Real>(m_width - 1), minY = static_cast<Real>(m_height - 1);
+    Real maxX = 0, maxY = 0;
+    for (Int x = 0; x < 2; ++x)
+    for (Int y = 0; y < 2; ++y)
+    {
+        const Real px = x ? hi.X : lo.X;
+        const Real py = y ? hi.Y : lo.Y;
+        const Vector3 ray(
+            matrix[0][0]*px + matrix[0][1]*py - matrix[0][2],
+            matrix[1][0]*px + matrix[1][1]*py - matrix[1][2],
+            matrix[2][0]*px + matrix[2][1]*py - matrix[2][2]);
+        if (ray.Z >= -0.0001f)
+            return IRegion2D{{0, 0}, {m_width - 1, m_height - 1}};
+        for (Int top = 0; top < 2; ++top)
+        {
+            const Real groundZ = top ? K_MAX_HEIGHT * MAP_HEIGHT_SCALE : 0.0f;
+            const Real distance = std::max(0.0f, (groundZ - origin.Z) / ray.Z);
+            const Real cellX = std::clamp((origin.X + ray.X*distance)/MAP_XY_FACTOR + m_borderSize, 0.0f, static_cast<Real>(m_width - 1));
+            const Real cellY = std::clamp((origin.Y + ray.Y*distance)/MAP_XY_FACTOR + m_borderSize, 0.0f, static_cast<Real>(m_height - 1));
+            minX = std::min(minX, cellX); maxX = std::max(maxX, cellX);
+            minY = std::min(minY, cellY); maxY = std::max(maxY, cellY);
+        }
+    }
+    return IRegion2D{{static_cast<Int>(floor(minX)), static_cast<Int>(floor(minY))},
+                    {static_cast<Int>(ceil(maxX)), static_cast<Int>(ceil(maxY))}};
+}
