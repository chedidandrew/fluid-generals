+// Bounded, opt-in native check invoked only by the camera diagnostic harness.
+bool cnc240::verifyMinimapDrag()
+{
+    GameWindow *window = TheWindowManager->winGetWindowFromId(nullptr, NAMEKEY("ControlBar.wnd:LeftHUD"));
+    if (!window || !rts::localPlayerHasRadar())
+    {
+        printf("CNC240_MINIMAP error=radar_unavailable\n");
+        return false;
+    }
+    ICoord2D origin, size;
+    window->winGetScreenPosition(&origin.x, &origin.y);
+    window->winGetSize(&size.x, &size.y);
+    ICoord2D mapLo, mapHi;
+    TheRadar->findDrawPositions(0, 0, size.x, size.y, &mapLo, &mapHi);
+    const Int mapWidth = mapHi.x - mapLo.x, mapHeight = mapHi.y - mapLo.y;
+    const ICoord2D a{origin.x + mapLo.x + mapWidth/2, origin.y + mapLo.y + mapHeight/2};
+    const ICoord2D b{origin.x + mapLo.x + mapWidth*3/4, a.y};
+    const ICoord2D c{origin.x + mapLo.x + mapWidth/4, a.y};
+    const ICoord2D outside{origin.x - 20, origin.y - 20};
+    const Coord2D originalPosition = TheTacticalView->getPosition2D();
+    const DrawableList selected = *TheInGameUI->getAllSelectedDrawables();
+    const CommandButton *command = TheInGameUI->getGUICommand();
+    const Bool alternate = TheGlobalData->m_useAlternateMouse;
+    TheInGameUI->deselectAllDrawables();
+    TheInGameUI->setGUICommand(nullptr);
+    const auto event = [](GameWindowMessage msg, ICoord2D point) {
+        ICoord2D delta{0, 0};
+        TheWindowManager->winProcessMouseEvent(msg, &point, &delta);
+    };
+    const auto different = [](Coord2D a, Coord2D b) {
+        return fabs(a.x-b.x) + fabs(a.y-b.y) > 1.0f;
+    };
+    const auto orders = []() {
+        Int count = 0;
+        for (GameMessage *m = TheMessageStream->getFirstMessage(); m; m = m->next())
+            if (m->getType() == GameMessage::MSG_DO_MOVETO) ++count;
+        return count;
+    };
+    event(GWM_LEFT_DOWN, a);
+    const bool captured = TheWindowManager->winGetCapture() == window;
+    const Coord2D first = TheTacticalView->getPosition2D();
+    event(GWM_LEFT_DRAG, b);
+    const Coord2D second = TheTacticalView->getPosition2D();
+    event(GWM_LEFT_DRAG, c);
+    const Coord2D third = TheTacticalView->getPosition2D();
+    event(GWM_LEFT_UP, outside);
+    const bool released = !TheWindowManager->winGetCapture();
+    event(GWM_LEFT_DRAG, b);
+    const bool stopped = !different(third, TheTacticalView->getPosition2D());
+    bool selectedDrag = false, selectedClick = false, alternateDrag = false;
+    Drawable *testDrawable = nullptr;
+    for (Object *o = TheGameLogic->getFirstObject(); o; o = o->getNextObject())
+        if (o->getControllingPlayer() == ThePlayerList->getLocalPlayer() && o->getDrawable())
+        { testDrawable = o->getDrawable(); break; }
+    if (testDrawable)
+    {
+        TheInGameUI->selectDrawable(testDrawable);
+        TheInGameUI->setGUICommand(nullptr);
+        TheWritableGlobalData->m_useAlternateMouse = FALSE;
+        const Int before = orders();
+        event(GWM_LEFT_DOWN, a); event(GWM_LEFT_DRAG, b); event(GWM_LEFT_UP, b);
+        selectedDrag = orders() == before && different(third, TheTacticalView->getPosition2D());
+        event(GWM_LEFT_DOWN, a); event(GWM_LEFT_UP, a);
+        selectedClick = orders() == before + 1;
+        // Remove only the test-generated move before it reaches game simulation.
+        GameMessage *lastMove = nullptr;
+        for (GameMessage *m = TheMessageStream->getFirstMessage(); m; m = m->next())
+            if (m->getType() == GameMessage::MSG_DO_MOVETO) lastMove = m;
+        if (selectedClick && lastMove) { TheMessageStream->removeMessage(lastMove); deleteInstance(lastMove); }
+        TheWritableGlobalData->m_useAlternateMouse = TRUE;
+        event(GWM_LEFT_DOWN, a);
+        const Coord2D altFirst = TheTacticalView->getPosition2D();
+        event(GWM_LEFT_DRAG, c); event(GWM_LEFT_UP, c);
+        alternateDrag = different(altFirst, TheTacticalView->getPosition2D()) && orders() == before;
+    }
+    TheWritableGlobalData->m_useAlternateMouse = alternate;
+    TheInGameUI->deselectAllDrawables();
+    for (Drawable *d : selected) TheInGameUI->selectDrawable(d);
+    TheInGameUI->setGUICommand(command);
+    TheTacticalView->setPosition2D(originalPosition);
+    const bool moved = different(first, second) && different(second, third);
+    printf("CNC240_MINIMAP captured=%d moved=%d released_outside=%d stopped=%d selected_drag_no_order=%d selected_click_order=%d alternate_drag=%d\n",
+           captured, moved, released, stopped, selectedDrag, selectedClick, alternateDrag);
+    fflush(stdout);
+    return captured && moved && released && stopped && selectedDrag && selectedClick && alternateDrag;
+}
