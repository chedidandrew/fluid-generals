+bool cnc240::checkTerrainCoverage()
+{
+    if (!TheTerrainRenderObject || !TheTerrainRenderObject->getMap() || !TheTacticalView)
+        return false;
+    WorldHeightMap *map = TheTerrainRenderObject->getMap();
+    const CameraClass *camera = static_cast<W3DView *>(TheTacticalView)->get3DCamera();
+    const IRegion2D required = map->getCameraDrawBounds(*camera);
+    const bool covered = map->getDrawOrgX() <= required.lo.x && map->getDrawOrgY() <= required.lo.y &&
+        map->getDrawOrgX() + map->getDrawWidth() - 1 >= required.hi.x &&
+        map->getDrawOrgY() + map->getDrawHeight() - 1 >= required.hi.y;
+    printf("CNC240_TERRAIN covered=%d draw=%dx%d map=%dx%d origin=%d,%d required=%d,%d:%d,%d\n",
+           covered, map->getDrawWidth(), map->getDrawHeight(), map->getXExtent(), map->getYExtent(),
+           map->getDrawOrgX(), map->getDrawOrgY(), required.lo.x, required.lo.y, required.hi.x, required.hi.y);
+    fflush(stdout);
+    return covered;
+}
