+// Left drag is camera navigation; an ordinary left click retains its unit-order meaning.
+// Capture ensures releasing outside the minimap ends the gesture reliably.
+WindowMsgHandledType LeftHUDInput(GameWindow *window, UnsignedInt msg,
+                                 WindowMsgData mData1, WindowMsgData mData2)
+{
+    struct Gesture
+    {
+        GameWindow *window = nullptr;
+        WindowMsgData start = 0;
+        Bool dragging = FALSE;
+        Bool pendingOrder = FALSE;
+    };
+    static Gesture gesture;
+    if (gesture.window && TheWindowManager->winGetCapture() != gesture.window)
+        gesture = Gesture{};
+    if (!rts::localPlayerHasRadar() || TheMouse->getMouseStatus()->middleState == MBS_Down)
+    {
+        if (gesture.window) TheWindowManager->winRelease(gesture.window);
+        gesture = Gesture{};
+        return LeftHUDClick(window, msg, mData1, mData2);
+    }
+    if (msg == GWM_LEFT_UP && gesture.window == window)
+    {
+        const Gesture finished = gesture;
+        TheWindowManager->winRelease(window);
+        gesture = Gesture{};
+        if (finished.pendingOrder && !finished.dragging)
+            return LeftHUDClick(window, GWM_LEFT_DOWN, finished.start, mData2);
+        return MSG_HANDLED;
+    }
+    if (msg == GWM_LEFT_DRAG && gesture.window == window)
+    {
+        const Int x = static_cast<Short>(mData1 & 0xFFFF);
+        const Int y = static_cast<Short>(mData1 >> 16);
+        if (abs(x - static_cast<Short>(gesture.start & 0xFFFF)) >= 3 ||
+            abs(y - static_cast<Short>(gesture.start >> 16)) >= 3)
+            gesture.dragging = TRUE;
+        if (gesture.dragging)
+        {
+            ICoord2D screen, pixel, radar;
+            Coord3D world;
+            window->winGetScreenPosition(&screen.x, &screen.y);
+            pixel.x = x - screen.x; pixel.y = y - screen.y;
+            if (TheRadar->localPixelToRadar(&pixel, &radar) && TheRadar->radarToWorld(&radar, &world))
+                TheTacticalView->userLookAt(&world);
+        }
+        return MSG_HANDLED;
+    }
+    if (msg == GWM_LEFT_DOWN)
+    {
+        const CommandButton *command = TheInGameUI->getGUICommand();
+        // Explicit attack-move and special-power targeting retain immediate clicks.
+        if (!command)
+        {
+            ICoord2D screen, pixel, radar;
+            Coord3D world;
+            window->winGetScreenPosition(&screen.x, &screen.y);
+            pixel.x = static_cast<Short>(mData1 & 0xFFFF) - screen.x;
+            pixel.y = static_cast<Short>(mData1 >> 16) - screen.y;
+            if (TheRadar->localPixelToRadar(&pixel, &radar) && TheRadar->radarToWorld(&radar, &world) &&
+                TheWindowManager->winCapture(window) == WIN_ERR_OK)
+            {
+                gesture.window = window;
+                gesture.start = mData1;
+                gesture.dragging = FALSE;
+                gesture.pendingOrder = !TheGlobalData->m_useAlternateMouse &&
+                                       !TheInGameUI->getAllSelectedLocalDrawables()->empty();
+                if (!gesture.pendingOrder) TheTacticalView->userLookAt(&world);
+                return MSG_HANDLED;
+            }
+        }
+    }
+    return LeftHUDClick(window, msg, mData1, mData2);
+}
